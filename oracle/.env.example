# ---------------------------------------------------------------------------
# SteemVM bridge oracle — environment template.
#
# Copy this to oracle/.env (which is gitignored), fill it in, then start the
# oracle alongside your node:
#
#     cp oracle/.env.example oracle/.env
#     # edit oracle/.env
#     docker compose up -d
#
# NEVER commit oracle/.env — it holds your validator's signing key.
# ---------------------------------------------------------------------------

# Your validator operator key — provide EXACTLY ONE of the two below.
#
# Recommended: export it from the key you already added to steemvmd (step 4 of
# Instructions/README.md):
#
#   docker exec steemvm-node /root/go/bin/steemvmd keys unsafe-export-eth-key \
#     blazed007 --keyring-backend test --home /root/.steemvm
#
# then paste the 64-hex-character result here (a leading 0x is fine too):
ORACLE_PRIVATE_KEY=
ORACLE_START_BLOCK=latest

# ...or supply the key's BIP39 mnemonic instead of the hex private key:
# ORACLE_MNEMONIC=word1 word2 ... word24

# Steem mainnet RPC to scan.
ORACLE_STEEM_RPC=https://api.steemit.com

# Where a fresh oracle starts scanning Steem: a block number, or "latest" to
# start at Steem's current tip. NEW VALIDATORS: set "latest" to skip all history
# and attest only deposits from now on (otherwise you scan from the chain's
# relayer_start_block anchor, which can be far back). Only applies on the first
# run — once a cursor is saved in the state volume, this is ignored.

# ---- optional overrides (sensible defaults; usually leave these unset) ------
# SteemVM node RPC the oracle broadcasts to (default: the compose node service).
# Go client only -- CometBFT RPC (see oracle/PROTOCOL.md SS4).
# ORACLE_NODE_RPC=http://steemvm:26657
# SteemVM node REST API the oracle broadcasts/queries against. Python and JS
# clients only -- they use the :1317 REST (gRPC-gateway) API instead of raw
# CometBFT RPC/gRPC (default: the compose node service; see oracle/PROTOCOL.md SS4).
# ORACLE_NODE_REST=http://steemvm:1317
# Directory for the scan-cursor state file (default: the oracle-data volume).
# ORACLE_STATE_DIR=/oracle-data
# Steem poll cadence (default 1m) and catch-up batch size (default 100).
# ORACLE_POLL_INTERVAL=1m
# ORACLE_MAX_BLOCKS=100

# ---- price feed (x/oracle/data) — shared by all three clients ---------------
# Bridge attestations above are fee-exempt; PRICE-FEED TXS ARE NOT. The key
# above needs a real asteem balance, and every prevote/vote tx pays gas at
# this price. See oracle/PROTOCOL.md §3.
# ORACLE_GAS_PRICES=1000000000asteem

# CoinMarketCap API key, used to price STEEM/USD_External and SBD/USD_External.
# Leave empty to skip those two pairs (the feeder still reveals/commits
# whatever pairs it CAN price — see oracle/PROTOCOL.md §7). Get a key at
# https://coinmarketcap.com/api/
# ORACLE_CMC_API_KEY=
# ORACLE_CMC_BASE_URL=https://pro-api.coinmarketcap.com

# STEEM/SBD_Internal (internal market) and Price_Feed (Steem's own
# witness-median feed price) are priced from the SAME Steem RPC configured
# above (ORACLE_STEEM_RPC) via get_ticker / get_feed_history — no separate
# endpoint needed.
