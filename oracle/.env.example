# SteemVM bridge oracle — environment template.
# cp oracle/.env.example oracle/.env, fill it in, then: docker compose up -d
# NEVER commit oracle/.env — it holds your validator's signing key.

# Validator key — exactly one of these two:
#   docker exec steemvm-node /root/go/bin/steemvmd keys unsafe-export-eth-key \
#     blazed007 --keyring-backend test --home /root/.steemvm
ORACLE_PRIVATE_KEY=
# ORACLE_MNEMONIC=word1 word2 ... word24

ORACLE_START_BLOCK=latest    # or a block number; "latest" skips history (new validators)
ORACLE_STEEM_RPC=https://api.steemit.com

# SBD bridging is ON by default. Set empty to disable and attest STEEM only.
# ORACLE_SBD_SYMBOL=SBD

# ---- optional overrides (sensible defaults) --------------------------------
# ORACLE_NODE_RPC=http://steemvm:26657        # Go client, CometBFT RPC
# ORACLE_NODE_REST=http://steemvm:1317        # Python/JS clients, REST API
# ORACLE_STATE_DIR=/oracle-data               # scan-cursor state
# ORACLE_POLL_INTERVAL=1m
# ORACLE_MAX_BLOCKS=100

# ---- price feed (x/oracle/data) --------------------------------------------
# Not fee-exempt — needs a funded key. Defaults to 1000000000asteem.
# ORACLE_GAS_PRICES=1000000000asteem

# Which external client prices STEEM/USD_External + SBD/USD_External:
# "cmc" (default) or "coingecko". Only the matching block below applies.
# ORACLE_PRICE_SOURCE=cmc

# CoinMarketCap — REQUIRED when ORACLE_PRICE_SOURCE=cmc (the default).
# Missing it means a missed price-feed duty (jailing/slashing risk).
# Free key: https://coinmarketcap.com/api/
ORACLE_CMC_API_KEY=
ORACLE_CMC_BASE_URL=https://pro-api.coinmarketcap.com

# CoinGecko — used when ORACLE_PRICE_SOURCE=coingecko. Unlike CMC, the key is
# OPTIONAL: the public /simple/price endpoint works keyless, just at a lower
# rate limit. Demo key: https://www.coingecko.com/en/api — set
# ORACLE_COINGECKO_BASE_URL=https://pro-api.coingecko.com for a pro-tier key.
# ORACLE_COINGECKO_API_KEY=
# ORACLE_COINGECKO_BASE_URL=https://api.coingecko.com

# STEEM/SBD_Internal + Price_Feed are priced from ORACLE_STEEM_RPC directly —
# no separate endpoint needed.

# ---- svm.bank multisig signer (oracle/PROTOCOL.md §11) --------------------
# Pays SVM withdrawals from @svm.bank and keeps its authority equal to each
# validator's exact share of stake. Off unless enabled.
# ORACLE_MULTISIG_ENABLED=true
#
# Your validator's Steem ACTIVE key (WIF) — the ONLY Steem key the signer uses.
# Owner changes on svm.bank are signed with active keys too, and active covers
# posting, so never put an owner key, posting key or master password here:
# the oracle refuses to start if ORACLE_STEEM_OWNER_WIF, ORACLE_STEEM_POSTING_WIF,
# ORACLE_STEEM_MASTER_PASSWORD (or OWNER / POSTING / MASTER_PASSWORD) is set.
# ORACLE_STEEM_ACTIVE_WIF=
#
# Steem nodes, own node first (defaults to ORACLE_STEEM_RPC).
# ORACLE_STEEM_RPCS=https://api.steemit.com,https://api.justyy.com
#
# Start with a dry run: every decision is logged, nothing is published.
# ORACLE_MULTISIG_DRY_RUN=true
#
# Shared rules: keep these identical on every validator.
# ORACLE_MULTISIG_THRESHOLD_PERCENT=75        # threshold = 75% of 10000
# ORACLE_MULTISIG_REWEIGHT_TOLERANCE=50       # weight points before a reweight
# ORACLE_MULTISIG_PAYOUT_MARGIN_BLOCKS=14400  # never pay this close to the SVM refund
#
# ORACLE_MULTISIG_INTERVAL=10s
# ORACLE_MULTISIG_PROPOSE=true                # false = only vote
# ORACLE_MULTISIG_EXECUTE=true
# ORACLE_MULTISIG_MAX_PER_TX_STEEM=           # optional per-payout cap, e.g. 500.000
# ORACLE_MULTISIG_MAX_PER_TX_SBD=
